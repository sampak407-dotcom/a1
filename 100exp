        "\n",
        "# 1. Import Libraries\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.metrics import (\n",
        "    mean_absolute_error,\n",
        "    mean_squared_error,\n",
        "    r2_score\n",
        ")\n",
        "\n",
        "import warnings\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "# 2. Load Dataset\n",
        "\n",
        "data = pd.read_csv(\"car_price_dataset.csv\")\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"CAR PRICE PREDICTION\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\"\\nFirst 5 Records:\")\n",
        "print(data.head())\n",
        "\n",
        "\n",
        "# 3. Display Dataset Information\n",
        "\n",
        "print(\"\\nDataset Shape:\")\n",
        "print(data.shape)\n",
        "\n",
        "print(\"\\nColumn Names:\")\n",
        "print(data.columns.tolist())\n",
        "\n",
        "print(\"\\nDataset Information:\")\n",
        "print(data.info())\n",
        "\n",
        "print(\"\\nStatistical Description:\")\n",
        "print(data.describe())\n",
        "\n",
        "\n",
        "# 4. Check Missing Values\n",
        "\n",
        "print(\"\\nMissing Values:\")\n",
        "print(data.isnull().sum())\n",
        "\n",
        "\n",
        "# 5. Check Duplicate Values\n",
        "\n",
        "print(\"\\nNumber of Duplicate Rows:\")\n",
        "print(data.duplicated().sum())\n",
        "\n",
        "\n",
        "# Remove duplicate rows if present\n",
        "data = data.drop_duplicates()\n",
        "\n",
        "print(\"\\nDataset Shape After Removing Duplicates:\")\n",
        "print(data.shape)\n",
        "\n",
        "\n",
        "# 6. Exploratory Data Analysis\n",
        "\n",
        "# Distribution of selling price\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.hist(\n",
        "    data[\"Selling_Price\"],\n",
        "    bins=10,\n",
        "    edgecolor=\"black\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Selling Price (Lakhs)\")\n",
        "plt.ylabel(\"Number of Cars\")\n",
        "plt.title(\"Distribution of Car Selling Prices\")\n",
        "\n",
        "plt.grid(axis=\"y\", alpha=0.3)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# 7. Present Price vs Selling Price\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.scatter(\n",
        "    data[\"Present_Price\"],\n",
        "    data[\"Selling_Price\"],\n",
        "    alpha=0.7\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Present Price (Lakhs)\")\n",
        "plt.ylabel(\"Selling Price (Lakhs)\")\n",
        "plt.title(\"Present Price vs Selling Price\")\n",
        "\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# 8. Year vs Selling Price\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.scatter(\n",
        "    data[\"Year\"],\n",
        "    data[\"Selling_Price\"],\n",
        "    alpha=0.7\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Manufacturing Year\")\n",
        "plt.ylabel(\"Selling Price (Lakhs)\")\n",
        "plt.title(\"Year vs Selling Price\")\n",
        "\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# 9. Kms Driven vs Selling Price\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.scatter(\n",
        "    data[\"Kms_Driven\"],\n",
        "    data[\"Selling_Price\"],\n",
        "    alpha=0.7\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Kilometers Driven\")\n",
        "plt.ylabel(\"Selling Price (Lakhs)\")\n",
        "plt.title(\"Kilometers Driven vs Selling Price\")\n",
        "\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# 10. Fuel Type Analysis\n",
        "\n",
        "plt.figure(figsize=(7, 5))\n",
        "\n",
        "sns.boxplot(\n",
        "    x=\"Fuel_Type\",\n",
        "    y=\"Selling_Price\",\n",
        "    data=data\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Fuel Type\")\n",
        "plt.ylabel(\"Selling Price (Lakhs)\")\n",
        "plt.title(\"Selling Price by Fuel Type\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# 11. Encode Categorical Variables\n",
        "\n",
        "fuel_encoder = LabelEncoder()\n",
        "seller_encoder = LabelEncoder()\n",
        "transmission_encoder = LabelEncoder()\n",
        "\n",
        "data[\"Fuel_Type\"] = fuel_encoder.fit_transform(\n",
        "    data[\"Fuel_Type\"]\n",
        ")\n",
        "\n",
        "data[\"Seller_Type\"] = seller_encoder.fit_transform(\n",
        "    data[\"Seller_Type\"]\n",
        ")\n",
        "\n",
        "data[\"Transmission\"] = transmission_encoder.fit_transform(\n",
        "    data[\"Transmission\"]\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\nEncoded Dataset:\")\n",
        "print(data.head())\n",
        "\n",
        "\n",
        "# 12. Select Features\n",
        "\n",
        "X = data[\n",
        "    [\n",
        "        \"Year\",\n",
        "        \"Present_Price\",\n",
        "        \"Kms_Driven\",\n",
        "        \"Fuel_Type\",\n",
        "        \"Seller_Type\",\n",
        "        \"Transmission\",\n",
        "        \"Owner\"\n",
        "    ]\n",
        "]\n",
        "\n",
        "# Target variable\n",
        "y = data[\"Selling_Price\"]\n",
        "\n",
        "\n",
        "print(\"\\nInput Features:\")\n",
        "print(X.head())\n",
        "\n",
        "print(\"\\nTarget Variable:\")\n",
        "print(y.head())\n",
        "\n",
        "\n",
        "# 13. Split Dataset\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.20,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "print(\"\\nTraining Data:\", X_train.shape)\n",
        "print(\"Testing Data :\", X_test.shape)\n",
        "\n",
        "\n",
        "# 14. Create Random Forest Model\n",
        "\n",
        "model = RandomForestRegressor(\n",
        "    n_estimators=100,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "\n",
        "# 15. Train Model\n",
        "\n",
        "print(\"\\nTraining Random Forest Model...\")\n",
        "\n",
        "model.fit(\n",
        "    X_train,\n",
        "    y_train\n",
        ")\n",
        "\n",
        "print(\"Training Completed!\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 16. Make Predictions\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "y_pred = model.predict(X_test)\n",
        "\n",
        "print(\"\\nPredicted Prices:\")\n",
        "print(y_pred)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 17. Model Evaluation\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "mae = mean_absolute_error(\n",
        "    y_test,\n",
        "    y_pred\n",
        ")\n",
        "\n",
        "mse = mean_squared_error(\n",
        "    y_test,\n",
        "    y_pred\n",
        ")\n",
        "\n",
        "rmse = np.sqrt(mse)\n",
        "\n",
        "r2 = r2_score(\n",
        "    y_test,\n",
        "    y_pred\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 60)\n",
        "print(\"MODEL PERFORMANCE\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\"Mean Absolute Error      :\", round(mae, 3))\n",
        "print(\"Mean Squared Error       :\", round(mse, 3))\n",
        "print(\"Root Mean Squared Error  :\", round(rmse, 3))\n",
        "print(\"R2 Score                 :\", round(r2, 3))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 18. Actual vs Predicted Price Graph\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(9, 6))\n",
        "\n",
        "plt.scatter(\n",
        "    y_test,\n",
        "    y_pred,\n",
        "    alpha=0.8\n",
        ")\n",
        "\n",
        "# Perfect prediction line\n",
        "minimum = min(\n",
        "    y_test.min(),\n",
        "    y_pred.min()\n",
        ")\n",
        "\n",
        "maximum = max(\n",
        "    y_test.max(),\n",
        "    y_pred.max()\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    [minimum, maximum],\n",
        "    [minimum, maximum],\n",
        "    linestyle=\"--\",\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Actual Car Price\")\n",
        "plt.ylabel(\"Predicted Car Price\")\n",
        "\n",
        "plt.title(\n",
        "    \"Actual vs Predicted Car Prices\"\n",
        ")\n",
        "\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 19. Feature Importance\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "importance = model.feature_importances_\n",
        "\n",
        "feature_names = X.columns\n",
        "\n",
        "feature_importance = pd.DataFrame({\n",
        "    \"Feature\": feature_names,\n",
        "    \"Importance\": importance\n",
        "})\n",
        "\n",
        "feature_importance = feature_importance.sort_values(\n",
        "    by=\"Importance\",\n",
        "    ascending=False\n",
        ")\n",
        "\n",
        "print(\"\\nFeature Importance:\")\n",
        "print(feature_importance)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 20. Feature Importance Graph\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "plt.bar(\n",
        "    feature_importance[\"Feature\"],\n",
        "    feature_importance[\"Importance\"]\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Features\")\n",
        "plt.ylabel(\"Importance\")\n",
        "plt.title(\"Feature Importance in Car Price Prediction\")\n",
        "\n",
        "plt.xticks(rotation=45)\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 21. Actual vs Predicted Line Graph\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "comparison = pd.DataFrame({\n",
        "    \"Actual\": y_test.values,\n",
        "    \"Predicted\": y_pred\n",
        "})\n",
        "\n",
        "comparison = comparison.reset_index(drop=True)\n",
        "\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "plt.plot(\n",
        "    comparison[\"Actual\"],\n",
        "    marker=\"o\",\n",
        "    label=\"Actual Price\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    comparison[\"Predicted\"],\n",
        "    marker=\"x\",\n",
        "    label=\"Predicted Price\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Test Car Number\")\n",
        "plt.ylabel(\"Selling Price (Lakhs)\")\n",
        "\n",
        "plt.title(\n",
        "    \"Actual Price vs Predicted Price\"\n",
        ")\n",
        "\n",
        "plt.legend()\n",
        "\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 22. Predict Price of a New Car\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Example new car:\n",
        "# Year = 2018\n",
        "# Present Price = 8.5 lakhs\n",
        "# Kms Driven = 25000\n",
        "# Fuel Type = Petrol\n",
        "# Seller Type = Dealer\n",
        "# Transmission = Manual\n",
        "# Owner = 0\n",
        "\n",
        "new_car = pd.DataFrame({\n",
        "    \"Year\": [2018],\n",
        "    \"Present_Price\": [8.5],\n",
        "    \"Kms_Driven\": [25000],\n",
        "    \"Fuel_Type\": [\n",
        "        fuel_encoder.transform([\"Petrol\"])[0]\n",
        "    ],\n",
        "    \"Seller_Type\": [\n",
        "        seller_encoder.transform([\"Dealer\"])[0]\n",
        "    ],\n",
        "    \"Transmission\": [\n",
        "        transmission_encoder.transform([\"Manual\"])[0]\n",
        "    ],\n",
        "    \"Owner\": [0]\n",
        "})\n",
        "\n",
        "\n",
        "# Predict\n",
        "new_prediction = model.predict(\n",
        "    new_car\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 60)\n",
        "print(\"NEW CAR PRICE PREDICTION\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\n",
        "    \"Estimated Selling Price:\",\n",
        "    round(new_prediction[0], 2),\n",
        "    \"Lakhs\"\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 23. Final Result\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 60)\n",
        "print(\"PROJECT COMPLETED SUCCESSFULLY\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\"Algorithm Used : Random Forest Regression\")\n",
        "print(\"Number of Trees:\", 100)\n",
        "print(\"R2 Score       :\", round(r2, 3))\n",
        "print(\n",
        "    \"Predicted Price:\",\n",
        "    round(new_prediction[0], 2),\n",
        "    \"Lakhs\"\n",
        ")"
      ]
    }
  ]
